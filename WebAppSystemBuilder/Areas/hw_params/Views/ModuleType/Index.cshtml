@using WebAppSystemBuilder.DTO.Items.HWComponent.RAM

@model IEnumerable<ModuleTypeDTO>

<h1>Index of RAM module types</h1>

<div class="container">
    <div class="row mb-3">
        <div class="col">
            @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Editor"))) {
                <a asp-action="Create" class="btn btn-success text-warning">Add new</a>
            }
        </div>
    </div>

    <div class="row">
        <table class="table table-sm table-striped text-center table-bordered">
            <thead class="table-primary">
                <tr>
                    <th class="col-2">Type</th>
                    <th class="col-10">Description</th>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Editor"))) {
                        <th>Action</th>
                        <th>ID:</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.ShortDesc</td>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Editor"))) {
                            <td>
                                <div class="d-grid gap-1 justify-content-between d-block d-md-flex">
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                    <form asp-action="Delete" method="post">
                                        <button type="submit" formmethod="post" class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</button>
                                    </form>
                                </div>
                            </td>
                            <td>@item.Id</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>